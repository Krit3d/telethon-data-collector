# --- Scraper variables ---

# Database & network settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg_parser

POSTS_LIMIT=10
CONCURRENCY=10
LOG_LEVEL=INFO
LOG_FORMAT=TEXT
NETWORK_RETRIES=5
NETWORK_RETRY_BASE_DELAY_S=1.0

# Postgres URL for the application (API connects to scraper server's database)
# DB_URL=postgresql+asyncpg://postgres:postgres@SCRAPER_SERVER_IP:5432/tg_parser
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_parser

# Telegram parser settings
PARSER_DELAY_MIN=0.5
PARSER_DELAY_MAX=2.0
CRAWLER_DELAY_MIN=35
CRAWLER_DELAY_MAX=100
ENABLE_WARMUP=false
USE_NATURAL_DELAYS=true

# Telegram API Credentials (get on my.telegram.org)
API_ID=your_id
API_HASH=your_hash

# Channels to handle (comma-separated usernames or links).
# If CHANNELS is set and not empty, it takes priority over channels.txt.
CHANNELS=durov,https://t.me/telegram,@somechannel

# Proxy settings (optional)
# PROXY_URL=socks5://user:pass@ip:port
# PROXY_URL=mtproxy://secret@ip:port
# PROXY_URL=mtproxy://ip:port?secret=..."
PROXY_URL=

# Scrape Creators API settings
SCRAPE_CREATORS_API_KEY=your_scrape_creators_api_key_here
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com
SCRAPE_CREATORS_HEADER_NAME=x-api-key
SCRAPE_CREATORS_AUTH_SCHEME=

# Creators coordinator settings (daemon mode)
CREATORS_POLL_INTERVAL_S=10
CREATORS_BATCH_SIZE=40
CREATORS_CONCURRENCY=3
CREATORS_MIN_SUBSCRIBERS=5000
CREATORS_STATUS_THRESHOLD_HOURS=24
MAX_POST_AGE_DAYS=15

# --- API variables ---

# Cloud.ru Evolution Foundation Models API
CLOUD_RU_API_KEY=your_cloud_ru_api_key_here
CLOUD_RU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUD_RU_EMBEDDING_MODEL=BAAI/bge-m3
CLOUD_RU_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Cloud.ru Evolution ML Inference Service
ML_INFERENCE_BASE_URL=your_ml_inference_base_url
ML_INFERENCE_MODEL=model-run-ngcds-facing
ML_INFERENCE_KEY_ID=your_access_key_id
ML_INFERENCE_SECRET=your_access_key_secret

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=social_posts
QDRANT_BATCH_SIZE=100
QDRANT_TIMEOUT=30.0

QDRANT_API_KEY=your_super_secret_api_key_here

# Extraction worker settings
# If true, process most recent posts first (ordered by published_at DESC).
# If false, process oldest posts first (ordered by id ASC).
EXTRACTION_PRIORITY_MODE=true
EMBEDDING_PRIORITY_MODE=true

# Extractors limitations
EMBEDDING_CONCURRENCY=5
EMBEDDING_BATCH_SIZE=64
GRAPH_CONCURRENCY=25
GRAPH_BATCH_SIZE=50
GRAPH_WRITE_CONCURRENCY=12

# Toggle video clip embedding generation.
# Set to 'false' on CPU-only hosts (prevents heavy visual models from loading).
# Set to 'true' on GPU production servers with CUDA execution providers.
ENABLE_VISUAL_EMBEDDINGS=false
